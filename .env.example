# ============================================================================
# SMART GATE ENVIRONMENT VARIABLES (.env)
# คัดลอกไฟล์นี้เป็น .env เพื่อใช้งาน
# ============================================================================

PORT=3000

# ----------------------------------------------------------------------------
# ฐานข้อมูล MySQL (หากยังไม่ได้กรอก ระบบจะทำงานในโหมด Demo Memory / Local JSON อัตโนมัติ)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=onepass_smartgate
DB_USER=onepass_user
DB_PASSWORD=your_mysql_password

# ----------------------------------------------------------------------------
# ความปลอดภัย / Authentication
# ----------------------------------------------------------------------------
# คีย์ลับสำหรับเซ็น JWT Token (เปลี่ยนเป็นค่าสุ่มที่คาดเดาไม่ได้ก่อนขึ้นระบบจริงเสมอ)
JWT_SECRET=change_this_to_a_long_random_secret_before_production

# ----------------------------------------------------------------------------
# USB Serial Bridge (เชื่อมต่อบอร์ด ESP32 ผ่านสาย USB COM)
# ----------------------------------------------------------------------------
# ตั้งเป็น true เมื่อรันบน Cloud/Hosting ที่ไม่มีพอร์ต USB/Python ให้ใช้ (ข้ามการรัน Serial Worker)
DISABLE_SERIAL=false

# ----------------------------------------------------------------------------
# LINE Notify (แจ้งเตือนผ่าน LINE - ถ้าไม่กรอก ระบบจะจำลองการแจ้งเตือนในคอนโซลแทน)
# ----------------------------------------------------------------------------
LINE_NOTIFY_TOKEN=your_line_notify_token
LINE_TOKEN=your_line_notify_token

# ----------------------------------------------------------------------------
# Google Gemini API (สำหรับ OCR อ่านตารางสอนจากรูปภาพ - ถ้าไม่กรอก จะใช้ Smart Parser สำรองแทน)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ----------------------------------------------------------------------------
# Telegram Bot (แจ้งเตือนคำร้อง/การอนุมัติ/การผ่านประตูผ่าน Telegram)
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=OnePassGateBot
# URL หลักของเว็บแอป ใช้สร้างลิงก์ในข้อความแจ้งเตือน Telegram/LINE
APP_BASE_URL=https://your-app-domain.example.com

# ----------------------------------------------------------------------------
# HiveMQ Cloud MQTT (สำหรับสั่งบอร์ด ESP32 ข้ามเน็ต)
# ----------------------------------------------------------------------------
MQTT_BROKER=your-cluster-url.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC_COMMAND=school/gate/cmd
MQTT_TOPIC_STATUS=school/gate/status
